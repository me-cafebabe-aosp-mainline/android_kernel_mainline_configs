# HID
CONFIG_HID=y
CONFIG_USB_HID=y

# Netfilter
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y

# Networking
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_IPV6=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCHED=y
